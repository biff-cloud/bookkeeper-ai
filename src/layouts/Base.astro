---
const { title, description = 'AI agents and tools for small accounting & bookkeeping firms, with real workflows.' } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(path, Astro.site);
const home = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/'), Astro.site).href;
const crumbs = [{ name: 'Home', item: home }];
if (canonical.href !== home) crumbs.push({ name: title, item: canonical.href });
const pageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical.href,
  isPartOf: { '@type': 'WebSite', name: 'Bookkeeper AI', url: home },
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, ...c })) },
});
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><script type="application/ld+json" set:html={pageLd}/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
<style>body{font-family:system-ui;max-width:860px;margin:auto;padding:1rem;line-height:1.5}nav a{margin-right:1rem}.card{border:1px solid #ddd;border-radius:8px;padding:1rem;margin:.6rem 0}</style>
</head><body><nav><a href={import.meta.env.BASE_URL}>Home</a><a href={`${import.meta.env.BASE_URL}/compare/dext-vs-hubdoc`}>Compare</a><a href={`${import.meta.env.BASE_URL}/sponsor`}>Sponsor / Submit</a></nav><slot/>
{Astro.url.pathname.includes('/compare/') && <p class="card"><strong>Vendor on this page?</strong> Founding sponsors get a labeled "Sponsored" card on this comparison and their category page, $249 for 60 days (max 3). Rankings and prices above don't change. <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sponsor`}>Sponsor this comparison</a></p>}
<footer><hr/><p>Contact: <a href="mailto:bookkeeperai@mail.grokbot.com">bookkeeperai@mail.grokbot.com</a></p><form onsubmit="event.preventDefault();alert('Newsletter coming soon')"><label>Weekly: 3 AI workflows for bookkeeping firms <input type="email" placeholder="you@firm.com" required/></label><button>Subscribe</button></form><img src="https://hits.sh/biff-cloud.github.io/bookkeeper-ai/pageviews.svg" alt="" width="1" height="1" style="position:absolute;opacity:0" referrerpolicy="no-referrer"/></footer></body></html>
