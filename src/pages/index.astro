---
import Base from '../layouts/Base.astro'; import tools from '../data/tools.json'; import cats from '../data/categories.json';
---
<Base title="AI Agents for Bookkeeping Firms — tools & real workflows">
<h1>AI agents & tools for small accounting and bookkeeping firms</h1>
<p>Curated, tested workflows: what to automate, which tool, what it costs.</p>
<h2>Categories</h2><ul>{Object.entries(cats).map(([k,v])=><li><a href={`${import.meta.env.BASE_URL}/category/${k}`}>{v}</a></li>)}</ul>
<h2>Comparisons</h2><ul><li><a href={`${import.meta.env.BASE_URL}/compare/dext-vs-hubdoc`}>Dext vs Hubdoc</a> — receipt capture for Xero/QBO practices</li><li><a href={`${import.meta.env.BASE_URL}/compare/booke-ai-vs-botkeeper`}>Booke AI vs Botkeeper</a> — categorization &amp; firm bookkeeping platforms</li><li><a href={`${import.meta.env.BASE_URL}/compare/docyt-vs-digits-vs-truewind`}>Docyt vs Digits vs Truewind</a> — AI month-end close</li><li><a href={`${import.meta.env.BASE_URL}/compare/dext-alternatives`}>Dext alternatives</a> — receipt capture options beyond Dext</li></ul>
<h2>Tools</h2>{tools.map(t=><div class="card"><a href={`${import.meta.env.BASE_URL}/tools/${t.slug}`}><b>{t.name}</b></a> — {t.summary}</div>)}
</Base>
