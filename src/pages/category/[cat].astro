---
import Base from '../../layouts/Base.astro'; import tools from '../../data/tools.json'; import cats from '../../data/categories.json';
export function getStaticPaths(){ return Object.entries(cats).map(([cat,label])=>({params:{cat},props:{label,list:tools.filter(t=>t.category===cat)}})); }
const { label, list } = Astro.props;
---
<Base title={`Best AI tools for ${label} in bookkeeping firms`}><h1>{label}</h1>{list.map(t=><div class="card"><a href={`${import.meta.env.BASE_URL}/tools/${t.slug}`}><b>{t.name}</b></a> — {t.useCase}</div>)}</Base>
